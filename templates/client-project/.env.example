# Copy to .env (git-ignored) and fill in for THIS client only. The Dev Container passes .env to the
# container. Never commit .env, never reuse another client's values, prefer short-lived or
# repository-scoped tokens. See README.md, "Credentials".
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
GH_TOKEN=

# Which environment from .ai/manifest.yaml you are working against, for example dev. While it is empty or not
# in the manifest, the framework denies deployment commands. It is not a credential.
AI_ENVIRONMENT=
