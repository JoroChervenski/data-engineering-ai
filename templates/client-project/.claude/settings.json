{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf /*)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "extraKnownMarketplaces": {
    "data-engineering-ai": {
      "source": {
        "source": "github",
        "repo": "JoroChervenski/data-engineering-ai"
      }
    }
  },
  "enabledPlugins": {
    "data-engineering-ai@data-engineering-ai": true
  }
}
