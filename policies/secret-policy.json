{
  "schema_version": 1,
  "name": "secret-policy",
  "description": "Paths no tool may read or write. 'never_allow' entries cannot be re-allowed by a project. A project may allow a narrower path through secrets.allow_paths in .ai/guardrails.json.",
  "protected_paths": [
    {
      "glob": "**/.ssh/**",
      "never_allow": true
    },
    {
      "glob": "**/.azure/**",
      "never_allow": true
    },
    {
      "glob": "**/.config/gh/**",
      "never_allow": true
    },
    {
      "glob": "**/.aws/**",
      "never_allow": true
    },
    {
      "glob": "**/.kube/config",
      "never_allow": true
    },
    {
      "glob": "**/.docker/config.json",
      "never_allow": true
    },
    {
      "glob": "**/.gnupg/**",
      "never_allow": true
    },
    {
      "glob": "**/.netrc",
      "never_allow": true
    },
    {
      "glob": "**/.git-credentials",
      "never_allow": true
    },
    {
      "glob": "**/.pgpass",
      "never_allow": true
    },
    {
      "glob": "**/id_rsa*",
      "never_allow": true
    },
    {
      "glob": "**/id_ed25519*",
      "never_allow": true
    },
    {
      "glob": "**/id_ecdsa*",
      "never_allow": true
    },
    {
      "glob": "**/*.pem",
      "never_allow": true
    },
    {
      "glob": "**/*.pfx",
      "never_allow": true
    },
    {
      "glob": "**/*.p12",
      "never_allow": true
    },
    {
      "glob": "**/proc/*/environ",
      "never_allow": true
    },
    {
      "glob": "**/.env"
    },
    {
      "glob": "**/.env.*",
      "exempt": [
        "**/.env.example",
        "**/.env.sample",
        "**/.env.template"
      ]
    },
    {
      "glob": "**/credentials*"
    },
    {
      "glob": "**/credentials*/**"
    },
    {
      "glob": "**/secrets*"
    },
    {
      "glob": "**/secrets*/**"
    }
  ],
  "search_programs": [
    "grep",
    "egrep",
    "fgrep",
    "rg",
    "ag",
    "ack",
    "sed",
    "awk"
  ],
  "output_only_programs": [
    "echo",
    "printf"
  ],
  "key_file_names": [
    "id_rsa",
    "id_ed25519",
    "id_ecdsa",
    ".env"
  ],
  "glob_hint_regex": "(?:^|/)\\.env|credentials|secrets|id_rsa|\\.ssh|\\.azure|\\.pem"
}
