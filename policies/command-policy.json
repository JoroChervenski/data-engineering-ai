{
  "schema_version": 1,
  "name": "command-policy",
  "description": "Classifies each simple shell command. A rule has a decision (allow, approval_required, deny) and a class; the capability policy then decides what each role may do with each class.",
  "combined_short_programs": [
    "rm",
    "git",
    "ls",
    "cp",
    "mv",
    "chmod",
    "chown",
    "chgrp",
    "grep",
    "egrep",
    "fgrep",
    "tar",
    "sed",
    "head",
    "tail",
    "sort",
    "du",
    "df",
    "ps",
    "docker",
    "npm",
    "pip",
    "pip3",
    "env",
    "set",
    "export",
    "declare",
    "typeset",
    "curl",
    "wget"
  ],
  "sql_clients": [
    "sqlcmd",
    "psql",
    "mysql",
    "mariadb",
    "sqlite3",
    "spark-sql",
    "beeline",
    "bq",
    "snowsql",
    "duckdb",
    "usql",
    "clickhouse-client",
    "sqlplus",
    "pgcli",
    "mycli",
    "isql"
  ],
  "interpreters": [
    "sh",
    "bash",
    "zsh",
    "dash",
    "ksh"
  ],
  "runner_wrappers": [
    "poetry",
    "uv",
    "pipenv",
    "pdm",
    "hatch",
    "rye"
  ],
  "wrappers": {
    "sudo": {
      "privileged": true,
      "flag_values": [
        "-u",
        "-g",
        "-h",
        "-p",
        "-C",
        "-D",
        "-R",
        "-T",
        "--user",
        "--group"
      ]
    },
    "doas": {
      "privileged": true,
      "flag_values": [
        "-u",
        "-C"
      ]
    },
    "env": {
      "flag_values": [
        "-u",
        "-C",
        "-S"
      ],
      "assignments": true
    },
    "nohup": {},
    "time": {},
    "command": {},
    "builtin": {},
    "exec": {},
    "setsid": {},
    "unbuffer": {},
    "nice": {
      "flag_values": [
        "-n"
      ]
    },
    "ionice": {
      "flag_values": [
        "-c",
        "-n",
        "-p"
      ]
    },
    "timeout": {
      "flag_values": [
        "-s",
        "-k",
        "--signal",
        "--kill-after"
      ],
      "positional_skip": 1
    },
    "stdbuf": {},
    "xargs": {
      "flag_values": [
        "-n",
        "-I",
        "-L",
        "-P",
        "-d",
        "-a",
        "-E",
        "-s"
      ]
    },
    "watch": {
      "flag_values": [
        "-n",
        "-d"
      ]
    }
  },
  "value_flags": {
    "git": [
      "-C",
      "-c",
      "--git-dir",
      "--work-tree",
      "--namespace",
      "--super-prefix",
      "--exec-path"
    ],
    "gh": [
      "-R",
      "--repo",
      "-H",
      "--hostname"
    ],
    "kubectl": [
      "-n",
      "--namespace",
      "--context",
      "--kubeconfig",
      "-f",
      "--filename",
      "-l",
      "--selector",
      "-o",
      "--output",
      "-c",
      "--container"
    ],
    "helm": [
      "-n",
      "--namespace",
      "--kube-context",
      "-f",
      "--values",
      "--set",
      "--version"
    ],
    "az": [
      "--subscription",
      "-g",
      "--resource-group",
      "-n",
      "--name",
      "-l",
      "--location",
      "-o",
      "--output",
      "--query",
      "--parameters",
      "-p",
      "--template-file",
      "-f"
    ],
    "terraform": [
      "-var",
      "-var-file",
      "-target",
      "-out",
      "-state",
      "-chdir"
    ],
    "docker": [
      "-f",
      "--file",
      "-H",
      "--host",
      "--context",
      "-e",
      "--env",
      "-v",
      "--volume",
      "-p",
      "--publish"
    ]
  },
  "privileged_rule": {
    "id": "CMD-A40",
    "class": "privileged",
    "decision": "approval_required",
    "reason": "Running as another user (sudo, su) changes the machine."
  },
  "privileged_programs": [
    "su"
  ],
  "pipeline_rules": [
    {
      "id": "CMD-D30",
      "class": "destructive",
      "decision": "deny",
      "reason": "Piping a download into a shell or interpreter runs unreviewed code.",
      "from_programs": [
        "curl",
        "wget",
        "fetch",
        "http",
        "https"
      ],
      "to_programs": [
        "sh",
        "bash",
        "zsh",
        "dash",
        "ksh",
        "python",
        "python3",
        "perl",
        "ruby",
        "node",
        "php",
        "sudo",
        "su"
      ]
    }
  ],
  "raw_rules": [
    {
      "id": "CMD-D11",
      "class": "destructive",
      "decision": "deny",
      "reason": "Fork bomb.",
      "regex": ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:"
    },
    {
      "id": "CMD-D31",
      "class": "destructive",
      "decision": "deny",
      "reason": "Running a downloaded script through command substitution runs unreviewed code.",
      "regex": "\\b(?:ba|z|da|k)?sh\\b[^\\n;&|]*(?:\\$\\(|<\\(|`)\\s*(?:curl|wget)\\b"
    }
  ],
  "destructive_fallback_regex": [
    "\\brm\\s+-[a-zA-Z]*[rR][a-zA-Z]*\\s+(?:--\\s+)?(?:/|~|\\$HOME)(?=[\\s/\\\"']|$)",
    "\\bgit\\s+push\\b[^\\n]*(?:--force|\\s-f\\b|\\s\\+)",
    "\\bgit\\s+reset\\s+--hard\\b",
    "\\bDROP\\s+(?:DATABASE|SCHEMA)\\b",
    ":\\(\\)\\s*\\{",
    "\\bmkfs\\b",
    "\\bcurl\\b[^\\n|]*\\|\\s*(?:sudo\\s+)?(?:ba|z)?sh\\b"
  ],
  "rules": [
    {
      "id": "CMD-D01",
      "class": "destructive",
      "decision": "deny",
      "reason": "Force-pushing rewrites remote history.",
      "program": "git",
      "positionals": [
        "push"
      ],
      "flags_any": [
        "--force",
        "-f",
        "--force-with-lease",
        "--force-if-includes",
        "--mirror",
        "--delete",
        "-d"
      ]
    },
    {
      "id": "CMD-D02",
      "class": "destructive",
      "decision": "deny",
      "reason": "A '+' refspec force-pushes.",
      "program": "git",
      "positionals": [
        "push"
      ],
      "args_regex": "(?:^|\\s)\\+[^\\s-]\\S*"
    },
    {
      "id": "CMD-D03",
      "class": "destructive",
      "decision": "deny",
      "reason": "git reset --hard discards work.",
      "program": "git",
      "positionals": [
        "reset"
      ],
      "flags_any": [
        "--hard"
      ]
    },
    {
      "id": "CMD-D04",
      "class": "destructive",
      "decision": "deny",
      "reason": "git clean -f deletes untracked files.",
      "program": "git",
      "positionals": [
        "clean"
      ],
      "flags_any": [
        "-f",
        "--force"
      ]
    },
    {
      "id": "CMD-D05",
      "class": "destructive",
      "decision": "deny",
      "reason": "Force-deleting a branch loses commits.",
      "program": "git",
      "positionals": [
        "branch"
      ],
      "flags_any": [
        "-D"
      ]
    },
    {
      "id": "CMD-D06",
      "class": "destructive",
      "decision": "deny",
      "reason": "This rewrites or erases Git history.",
      "program": "git",
      "positionals_any": [
        [
          "filter-branch"
        ],
        [
          "stash",
          "clear"
        ],
        [
          "update-ref"
        ],
        [
          "reflog",
          "expire"
        ],
        [
          "reflog",
          "delete"
        ]
      ]
    },
    {
      "id": "CMD-D07",
      "class": "destructive",
      "decision": "deny",
      "reason": "Pruning objects immediately cannot be undone.",
      "program": "git",
      "positionals": [
        "gc"
      ],
      "args_regex": "--prune=now"
    },
    {
      "id": "CMD-D08",
      "class": "destructive",
      "decision": "deny",
      "reason": "Recursive delete of a system or home root.",
      "program": "rm",
      "flags_any": [
        "-r",
        "-R",
        "--recursive"
      ],
      "targets_regex": "^(?:/|/\\*|~/?|\\$\\{?HOME\\}?/?|\\.\\./?|/(?:etc|usr|var|bin|sbin|lib|lib64|boot|dev|home|root|opt|srv|mnt|proc|sys)(?:/\\*?)?)$"
    },
    {
      "id": "CMD-D09",
      "class": "destructive",
      "decision": "deny",
      "reason": "Writing to or formatting a block device destroys data.",
      "program_regex": "^(?:mkfs(?:\\..+)?|fdisk|sfdisk|cfdisk|parted|wipefs)$"
    },
    {
      "id": "CMD-D10",
      "class": "destructive",
      "decision": "deny",
      "reason": "dd to a device destroys data.",
      "program": "dd",
      "args_regex": "\\bof=/dev/"
    },
    {
      "id": "CMD-D12",
      "class": "destructive",
      "decision": "deny",
      "reason": "Recursive permission or owner change on a system root.",
      "program": [
        "chmod",
        "chown",
        "chgrp"
      ],
      "flags_any": [
        "-R",
        "--recursive"
      ],
      "targets_regex": "^(?:/|/\\*|~/?|\\$\\{?HOME\\}?/?|\\.\\./?|/(?:etc|usr|var|bin|sbin|lib|lib64|boot|dev|home|root|opt|srv|mnt|proc|sys)(?:/\\*?)?)$"
    },
    {
      "id": "CMD-D13",
      "class": "destructive",
      "decision": "deny",
      "reason": "DROP DATABASE / DROP SCHEMA destroys data.",
      "program": [
        "sqlcmd",
        "psql",
        "mysql",
        "mariadb",
        "sqlite3",
        "spark-sql",
        "beeline",
        "bq",
        "snowsql",
        "duckdb",
        "usql",
        "clickhouse-client",
        "sqlplus",
        "pgcli",
        "mycli",
        "isql"
      ],
      "args_regex": "\\bDROP\\s+(?:DATABASE|SCHEMA)\\b"
    },
    {
      "id": "CMD-D14",
      "class": "secret",
      "decision": "deny",
      "reason": "This prints environment variables, which can include injected credentials.",
      "program": [
        "printenv",
        "compgen"
      ]
    },
    {
      "id": "CMD-D15",
      "class": "secret",
      "decision": "deny",
      "reason": "A bare 'env' or 'set' prints every variable, including injected credentials.",
      "program": [
        "env",
        "set"
      ],
      "extra_max": 0,
      "flags_none": [
        "-e",
        "-u",
        "-x",
        "-o",
        "+e",
        "+x",
        "-eu",
        "-euo"
      ]
    },
    {
      "id": "CMD-D16",
      "class": "secret",
      "decision": "deny",
      "reason": "This prints environment variables, which can include injected credentials.",
      "program": [
        "export",
        "declare",
        "typeset"
      ],
      "flags_any": [
        "-p",
        "-x"
      ]
    },
    {
      "id": "CMD-D17",
      "class": "secret",
      "decision": "deny",
      "reason": "This reads or prints a credential.",
      "program": "git",
      "positionals": [
        "credential"
      ]
    },
    {
      "id": "CMD-D18",
      "class": "secret",
      "decision": "deny",
      "reason": "This prints an access token or secret value.",
      "program": "az",
      "positionals_any": [
        [
          "account",
          "get-access-token"
        ],
        [
          "keyvault",
          "secret",
          "show"
        ],
        [
          "keyvault",
          "secret",
          "download"
        ],
        [
          "keyvault",
          "key",
          "show"
        ]
      ]
    },
    {
      "id": "CMD-D19",
      "class": "secret",
      "decision": "deny",
      "reason": "This prints an access token.",
      "program": "gh",
      "positionals": [
        "auth",
        "token"
      ]
    },
    {
      "id": "CMD-D20",
      "class": "secret",
      "decision": "deny",
      "reason": "This prints an access token or secret value.",
      "program": [
        "aws",
        "gcloud"
      ],
      "args_regex": "(?:get-secret-value|get-session-token|print-access-token|print-identity-token)"
    },
    {
      "id": "CMD-D21",
      "class": "secret",
      "decision": "deny",
      "reason": "Exporting secret keys.",
      "program": "gpg",
      "flags_any": [
        "--export-secret-keys",
        "--export-secret-subkeys"
      ]
    },
    {
      "id": "CMD-D22",
      "class": "secret",
      "decision": "deny",
      "reason": "Reading Kubernetes secrets.",
      "program": "kubectl",
      "positionals": [
        "get"
      ],
      "args_regex": "\\bsecrets?\\b"
    },
    {
      "id": "CMD-A01",
      "class": "remote_write",
      "decision": "approval_required",
      "reason": "Pushing publishes commits to a remote.",
      "program": "git",
      "positionals": [
        "push"
      ]
    },
