    },
    {
      "id": "CMD-A05",
      "class": "remote_write",
      "decision": "approval_required",
      "reason": "Publishing a package is public and permanent.",
      "program_regex": "^(?:twine|npm|pnpm|yarn|cargo|gem|docker|podman)$",
      "positionals_any": [
