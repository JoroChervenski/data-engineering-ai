    {
      "id": "CMD-A03",
      "class": "remote_write",
      "decision": "approval_required",
      "reason": "gh api with a method, fields or a body can change remote state.",
      "program": "gh",
      "positionals": [
        "api"
      ],
      "flags_any": [
        "-X",
        "--method",
        "-f",
        "-F",
        "--field",
        "--raw-field",
        "--input"
      ],
      "args_regex_none": "(?:-X|--method)[ =]GET\\b"
    },
    {
      "id": "CMD-A04",
      "class": "remote_write",
      "decision": "approval_required",
      "reason": "An HTTP request that sends data can change remote state.",
      "program": [
        "curl",
        "wget",
        "http",
        "https"
      ],
      "flags_any": [
        "-X",
        "--request",
        "-d",
        "--data",
        "--data-raw",
        "--data-binary",
        "--data-urlencode",
        "-F",
        "--form",
        "-T",
        "--upload-file",
        "--json",
